# Admin-edited directly -- copy to permissions.yml and fill in real users.
# No UI for this; it's a handful of family accounts, not worth building one.
#
# This file is both the account list and the permission list. A user exists
# because they appear here with a `password_hash`; there is no separate user
# store and no self-registration.
#
# Generate a hash (never commit the password itself):
#
#   python3 -c "from werkzeug.security import generate_password_hash as h; \
#               import getpass; print(h(getpass.getpass()))"
#
# These livecam accounts are separate from ZoneMinder's own accounts. ZM
# still prompts for its own login when someone opens recordings & settings.
#
# Keys starting with `_` are metadata, not users. _monitor_id_to_name maps
# ZM's numeric Monitor IDs (assigned when each Monitor is created, see
# ansible/roles/applications/camera_nvr) to the camera names used in each
# user's `cameras` list below.
_monitor_id_to_name:
  1: guinea-pig-cage-1
  2: guinea-pig-cage-2

# Example user -- full access, all hours.
alice:
  password_hash: "pbkdf2:sha256:600000$REPLACE$ME"
  cameras:
    - guinea-pig-cage-1
    - guinea-pig-cage-2
  audio: true

# Example user -- one camera, no audio, daytime only. The window is
# re-checked while a stream runs, so it cuts a live view off at 20:00
# rather than only refusing a new one.
bob:
  password_hash: "pbkdf2:sha256:600000$REPLACE$ME"
  cameras:
    - guinea-pig-cage-1
  audio: false
  time_window:
    start: "08:00:00"
    end: "20:00:00"
